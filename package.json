{
  "name": "@svguitar/chords-plugin",
  "version": "0.0.1",
  "description": "SVGuitar plugin to draw chord diagrams from chord names like \"C#\".",
  "keywords": [
    "guitar",
    "guitar-chords",
    "svg",
    "chord",
    "diagram",
    "svguitar",
    "svguitar-plugin"
  ],
  "main": "dist/chords-plugin.umd.js",
  "module": "dist/chords-plugin.es.js",
  "types": "dist/types/chords-plugin.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/chords-plugin.d.ts",
      "import": "./dist/chords-plugin.es.js",
      "require": "./dist/chords-plugin.umd.js"
    }
  },
  "files": [
    "dist"
  ],
  "author": "Raphael Voellmy <r.voellmy@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omnibrain/svguitar-chords-plugin.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "format": "prettier --write '{src,test}/**/*.ts'",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "prebuild": "rimraf dist",
    "build": "rollup -c rollup.config.mjs",
    "start": "rollup -c rollup.config.mjs -w",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage --watch",
    "test:prod": "run-s lint typecheck test",
    "prepare": "husky"
  },
  "peerDependencies": {
    "@svguitar/core": "^2.9.0"
  },
  "lint-staged": {
    "{src,test}/**/*.ts": [
      "prettier --write"
    ]
  },
  "jest": {
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node",
    "testRegex": "(/__tests__/.*|\\.(test|spec))\\.ts$",
    "moduleFileExtensions": [
      "ts",
      "js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/test/"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 90,
        "functions": 95,
        "lines": 95,
        "statements": 95
      }
    },
    "collectCoverageFrom": [
      "src/*.ts"
    ],
    "setupFiles": [
      "<rootDir>/test/setup.ts"
    ]
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@svguitar/core": "^2.9.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/svgdom": "^0.1.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "rollup": "^4.64.2",
    "svgdom": "^0.1.29",
    "ts-jest": "^29.4.14",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
